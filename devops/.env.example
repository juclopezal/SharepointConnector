# ── Azure AD App Registration ────────────────────────────────────────────────
# Required permissions: Sites.Read.All, Sites.ReadWrite.All
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET=your-client-secret

# ── Application ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
# Zona horaria (IANA) del tenant de SharePoint para acotar los periodos del
# upsert (p. ej. Europe/Madrid). Por defecto UTC.
TENANT_TIMEZONE=UTC
# Directory for the persistent rotating log file (in addition to console).
# Leave empty to log to console only.
LOG_DIR=
LOG_FILE=api_server_sp_connector.log

# ── Autenticación por clave de API (SPEC-005) ────────────────────────────────
# Secreto de servidor para el HMAC-SHA256 de las claves. Genera uno robusto, p. ej.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# IMPORTANTE: si lo dejas VACÍO, la autenticación queda DESHABILITADA y el servicio
# NO exige X-API-Key (modo compatibilidad para el despliegue escalonado). Fíjalo
# para forzar la validación. Si lo cambias, todas las claves existentes dejan de
# validar y hay que reemitirlas.
API_KEY_HMAC_SECRET=
# Ruta del archivo SQLite con las claves habilitadas. Debe estar en un volumen
# persistente (ver docker-compose.yml), nunca dentro de la imagen.
API_KEY_DB_PATH=data/api_keys.db

# ── Runtime ──────────────────────────────────────────────────────────────────
# Host port mapped to the container's internal port 8003.
SP_PORT=8003
